{
  "name": "hashtree-cc",
  "version": "0.1.2",
  "license": "MIT",
  "private": true,
  "description": "hashtree.cc - decentralized file sharing & developer tools",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree-cc",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree-cc/apps/hashtree-cc",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/hashtree-cc?tab=issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build:deps": "pnpm --dir ../../../fips-ts --filter @fips/core --filter @fips/browser --filter @fips/transport-webrtc build && pnpm --dir ../../../hashtree/ts --filter @hashtree/core --filter @hashtree/index --filter @hashtree/collection --filter @hashtree/dexie --filter @hashtree/nostr --filter @hashtree/fips-transport build && pnpm --dir ../.. --filter ndk build && pnpm --dir ../.. --filter ndk-cache build && pnpm --dir ../.. --filter nostr-social-graph build",
    "dev": "pnpm run build:deps && vite",
    "build": "pnpm run build:deps && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:release": "node --test tests/releaseSite.test.mjs tests/hashtreePaths.test.mjs tests/httpsStaticAssetsWorker.test.mjs",
    "test:portable": "pnpm run build && node --test tests/portable-build.test.mjs && node ./scripts/portable-smoke.mjs",
    "smoke:portable": "node ./scripts/portable-smoke.mjs",
    "publish:portable": "pnpm run build && node --test tests/portable-build.test.mjs && node ./scripts/portable-smoke.mjs && node ./scripts/publish-portable.mjs",
    "release:site": "node ./scripts/release-site.mjs"
  },
  "dependencies": {
    "@fips/browser": "link:../../../fips-ts/packages/browser",
    "@fips/core": "link:../../../fips-ts/packages/core",
    "@fips/transport-webrtc": "link:../../../fips-ts/packages/transport-webrtc",
    "@hashtree/core": "link:../../../hashtree/ts/packages/hashtree",
    "@hashtree/fips-transport": "link:../../../hashtree/ts/packages/hashtree-fips-transport",
    "@hashtree/nostr": "link:../../../hashtree/ts/packages/hashtree-nostr",
    "@hashtree/worker": "link:../../../hashtree/ts/packages/hashtree-worker",
    "minidenticons": "^4.2.1",
    "nostr-tools": "^2.18.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.75",
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/qrcode": "^1.5.6",
    "@unocss/preset-icons": "^66.5.9",
    "svelte": "^5.16.0",
    "typescript": "^5.3.0",
    "unocss": "^66.5.9",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-precaching": "^7.4.0",
    "workbox-window": "^7.4.0",
    "ws": "^8.18.3"
  }
}
